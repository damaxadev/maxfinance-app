rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'REEMPLAZAR_DESPUES_DE_FASE_1';
    }

    // users — doc id == uid
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // accounts — siempre personales
    match /accounts/{accountId} {
      allow read, update, delete: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
    }

    // categories — uid == null son categorías base/seed: legibles por
    // cualquier usuario autenticado, pero no creables desde el cliente.
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow update, delete: if resource.data.uid != null && isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
    }

    // budgets — siempre personales
    match /budgets/{budgetId} {
      allow read, update, delete: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
    }

    // recurringPayments — reglas para la variante personal (uid != null).
    // TODO (Fase 5): reglas para recurringPayments de grupo (uid == null, groupId != null).
    match /recurringPayments/{paymentId} {
      allow read, update, delete: if resource.data.uid != null && isOwner(resource.data.uid);
      allow create: if request.resource.data.uid != null && isOwner(request.resource.data.uid);
    }

    // groups — lectura para miembros o admin; update/delete solo para
    // quien creó el grupo o el admin. Salir del grupo sin ser creador ni
    // admin queda para una Cloud Function callable en Fase 3.
    match /groups/{groupId} {
      allow read: if (isSignedIn() && request.auth.uid in resource.data.members) || isAdmin();
      allow update, delete: if (isSignedIn() && request.auth.uid == resource.data.createdBy) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
    }

    // movements — si groupId es null, solo el dueño; si tiene groupId,
    // cualquier miembro del grupo puede leer, pero solo escribe quien creó el registro.
    match /movements/{movementId} {
      allow read: if resource.data.groupId == null
        ? isOwner(resource.data.uid)
        : isGroupMember(resource.data.groupId);

      allow create: if isOwner(request.resource.data.uid) &&
        (request.resource.data.groupId == null || isGroupMember(request.resource.data.groupId));

      allow update, delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // settlements — solo miembros del grupo correspondiente; create además
    // exige ser una de las dos partes de la deuda (no cualquier miembro).
    match /settlements/{settlementId} {
      allow read: if isGroupMember(resource.data.groupId);

      allow create: if isAdmin() || (
        isGroupMember(request.resource.data.groupId) &&
        (request.auth.uid == request.resource.data.fromUid ||
         request.auth.uid == request.resource.data.toUid)
      );

      allow update, delete: if isGroupMember(resource.data.groupId) || isAdmin();
    }
  }
}
