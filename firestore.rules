rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'jigrWtmRAraKgs6aJSS4OMq9gaX2';
    }

    // users — doc id == uid
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // accounts — siempre personales
    match /accounts/{accountId} {
      allow read, update, delete: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
    }

    // categories — uid == null son categorías base/seed: legibles por
    // cualquier usuario autenticado, pero no creables desde el cliente.
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow update, delete: if resource.data.uid != null && isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
    }

    // budgets — siempre personales. Verificado con el flujo real de Fase 6
    // (Budgets.setLimit(), id determinístico uid_categoryId_month): sigue
    // siendo un create/update normal sobre el propio doc, no hizo falta
    // tocar nada.
    match /budgets/{budgetId} {
      allow read, update, delete: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
    }

    // recurringPayments — reglas para la variante personal (uid != null).
    // TODO (Fase 5): reglas para recurringPayments de grupo (uid == null, groupId != null).
    // Verificado con el flujo real de Fase 6 (RecurringPaymentsService CRUD
    // desde el cliente + la Cloud Function programada que crea el movement
    // resultante y avanza nextDate): el CRUD del cliente sigue siendo
    // create/update/delete normales sobre el propio doc, sin cambios. La
    // función programada corre con el Admin SDK (bypassa estas reglas por
    // diseño, igual que inviteGroupMember/leaveGroup), así que tampoco
    // necesitó ningún permiso adicional acá.
    match /recurringPayments/{paymentId} {
      allow read, update, delete: if resource.data.uid != null && isOwner(resource.data.uid);
      allow create: if request.resource.data.uid != null && isOwner(request.resource.data.uid);
    }

    // groups — lectura para miembros o admin; update/delete solo para
    // quien creó el grupo o el admin. Salir del grupo sin ser creador, e
    // invitar por email, corren server-side vía Cloud Functions callable
    // (functions/src/index.ts: leaveGroup, inviteGroupMember) — no
    // necesitan un permiso de update más amplio en el cliente.
    match /groups/{groupId} {
      allow read: if (isSignedIn() && request.auth.uid in resource.data.members) || isAdmin();
      allow update, delete: if (isSignedIn() && request.auth.uid == resource.data.createdBy) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
    }

    // monthlyInsights — insight automático mensual (functions/src/index.ts,
    // generateMonthlyInsights), doc id determinístico {uid}_{month}. Solo
    // lectura para el dueño — se escribe únicamente vía Admin SDK (bypassa
    // estas reglas), igual que las categorías base: el cliente nunca
    // escribe acá directo (ver DATABASE.md).
    match /monthlyInsights/{insightId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
    }

    // movements — si groupId es null, solo el dueño; si tiene groupId,
    // cualquier miembro del grupo puede leer, pero solo escribe quien creó el registro.
    // Verificado con el flujo real de Fase 5 (gasto compartido + query por
    // groupId constante para el cálculo de balance): no hizo falta tocar
    // nada, groupId sigue siendo un filtro de igualdad conocido, así que
    // Firestore puede probar isGroupMember(groupId) estáticamente para
    // toda la lista (mismo mecanismo ya usado por groupMovements$/remove()).
    //
    // Verificado también con las consultas de 44b-44e (vista de Movimientos
    // combinada, historial de actividad, "ver todos" y el check de
    // movimiento ya vinculado): todas siguen filtrando por igualdades
    // constantes (uid, groupId, settlementId — incluido el 'in' de
    // settlementId) sin ningún orderBy sobre un campo distinto al filtrado,
    // así que ninguna necesita un índice compuesto nuevo — quedan cubiertas
    // por los índices de campo único que Firestore crea automáticamente.
    match /movements/{movementId} {
      allow read: if resource.data.groupId == null
        ? isOwner(resource.data.uid)
        : isGroupMember(resource.data.groupId);

      allow create: if isOwner(request.resource.data.uid) &&
        (request.resource.data.groupId == null || isGroupMember(request.resource.data.groupId));

      allow update, delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // settlements — solo miembros del grupo correspondiente; create además
    // exige ser una de las dos partes de la deuda (no cualquier miembro).
    // Verificado con el flujo real de Fase 5 (SettlementsService.create()):
    // el cliente siempre asigna fromUid/toUid a partir de un edge de deuda
    // donde el usuario actual ya es una de las dos partes, así que nunca
    // choca con este create. Tampoco hizo falta una Cloud Function — el
    // batch de settlement + movement personal opcional se hace directo,
    // porque ambos son creates (nunca updates) desde cero.
    match /settlements/{settlementId} {
      allow read: if isGroupMember(resource.data.groupId);

      allow create: if isAdmin() || (
        isGroupMember(request.resource.data.groupId) &&
        (request.auth.uid == request.resource.data.fromUid ||
         request.auth.uid == request.resource.data.toUid)
      );

      allow update, delete: if isGroupMember(resource.data.groupId) || isAdmin();
    }
  }
}
